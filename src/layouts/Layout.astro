---
export interface Props {
  title: string;
  description?: string;
}

import '../styles/global.css';

const { title, description } = Astro.props;
const siteTitle = "Fiction";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · {siteTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
  </head>
  <body>
    <button id="theme-toggle" aria-label="Toggle dark mode">Dark</button>

    <header>
      <div class="site-title">{siteTitle}</div>
      <nav>
        <a href="/">Home</a>
        <a href="/categories">Categories</a>
        <a href="/about">About</a>
        <a href="/rss.xml">RSS</a>
      </nav>
      <div class="search-container">
        <input id="search-input" type="search" placeholder="Search" aria-label="Search" />
        <div id="search-results" role="list"></div>
      </div>
    </header>

    <slot />

    <footer>
      Built with care · <a href="/rss.xml">RSS</a>
    </footer>

    <script>
      // Minimal dark mode toggle (no dependencies, ~15 lines)
      const btn = document.getElementById('theme-toggle');
      const html = document.documentElement;

      function setTheme(theme) {
        if (theme === 'dark') {
          html.setAttribute('data-theme', 'dark');
          btn.textContent = 'Light';
          localStorage.setItem('theme', 'dark');
        } else {
          html.removeAttribute('data-theme');
          btn.textContent = 'Dark';
          localStorage.setItem('theme', 'light');
        }
      }

      // Initialize from localStorage or system
      const saved = localStorage.getItem('theme');
      if (saved) {
        setTheme(saved);
      } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        setTheme('dark');
      } else {
        btn.textContent = 'Dark';
      }

      btn.addEventListener('click', () => {
        const current = html.getAttribute('data-theme');
        setTheme(current === 'dark' ? 'light' : 'dark');
      });
    </script>

    <script type="module">
      // Minimal client-side search (loads /search.json produced at build time)
      async function loadIndex() {
        try {
          const res = await fetch('/search.json');
          if (!res.ok) return [];
          return await res.json();
        } catch (e) { return []; }
      }

      function escapeHtml(s) {
        return s.replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'})[c]);
      }

      (function() {
        const input = document.getElementById('search-input');
        const results = document.getElementById('search-results');
        let index = null;

        if (!input || !results) return;

        input.addEventListener('input', async (ev) => {
          const q = (ev.target.value || '').trim().toLowerCase();
          if (!q) {
            results.innerHTML = '';
            results.style.display = 'none';
            return;
          }

          if (!index) index = await loadIndex();

          const matches = index.filter(item => {
            const t = item.title || '';
            const e = item.excerpt || '';
            return t.toLowerCase().includes(q) || e.toLowerCase().includes(q);
          }).slice(0, 12);

          if (!matches.length) {
            results.innerHTML = '<div class="no-results">No results</div>';
            results.style.display = 'block';
            return;
          }

          results.innerHTML = matches.map(item => {
            return `<a class="search-result" role="listitem" href="${escapeHtml(item.url)}"><div class="search-title">${escapeHtml(item.title)}</div><div class="search-excerpt">${escapeHtml(item.excerpt || '')}</div></a>`;
          }).join('');

          results.style.display = 'block';
        });
      })();
    </script>
  </body>
</html>
