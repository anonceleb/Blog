---
export interface Props {
  title: string;
  description?: string;
}

import '../styles/global.css';

const { title, description } = Astro.props;
const siteTitle = "Essays";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · {siteTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
  </head>
  <body>
    <button id="theme-toggle" aria-label="Toggle dark mode">Dark</button>

    <header>
      <div class="site-title">{siteTitle}</div>
      <nav>
        <a href="/">Home</a>
        <a href="/categories">Categories</a>
        <a href="/about">About</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </header>

    <slot />

    <footer>
      Built with care · <a href="/rss.xml">RSS</a>
    </footer>

    <script>
      // Minimal dark mode toggle (no dependencies, ~15 lines)
      const btn = document.getElementById('theme-toggle');
      const html = document.documentElement;

      function setTheme(theme) {
        if (theme === 'dark') {
          html.setAttribute('data-theme', 'dark');
          btn.textContent = 'Light';
          localStorage.setItem('theme', 'dark');
        } else {
          html.removeAttribute('data-theme');
          btn.textContent = 'Dark';
          localStorage.setItem('theme', 'light');
        }
      }

      // Initialize from localStorage or system
      const saved = localStorage.getItem('theme');
      if (saved) {
        setTheme(saved);
      } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        setTheme('dark');
      } else {
        btn.textContent = 'Dark';
      }

      btn.addEventListener('click', () => {
        const current = html.getAttribute('data-theme');
        setTheme(current === 'dark' ? 'light' : 'dark');
      });
    </script>
  </body>
</html>
