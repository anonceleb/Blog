---
export interface Props {
  title?: string;
  description?: string;
  publishedTime?: Date | string;
  type?: 'website' | 'article';
}

import '../styles/global.css';
import Head from '../components/Head.astro';

const { title, description, publishedTime, type } = Astro.props;
const siteTitle = 'Fiction';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Head title={title} description={description} publishedTime={publishedTime} type={type} />
    <script is:inline>
      // Runs before first paint so the page never flashes the wrong theme.
      // Only an explicit choice sets data-theme; otherwise the OS decides via CSS.
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <button id="theme-toggle" aria-label="Toggle dark mode">Dark</button>

    <header>
      <div class="site-title">{siteTitle}</div>
      <nav>
        <a href="/">Home</a>
        <a href="/categories/">Categories</a>
        <a href="/about/">About</a>
        <a href="/rss.xml">RSS</a>
      </nav>
      <div class="search-container">
        <input id="search-input" type="search" placeholder="Search" aria-label="Search" />
        <div id="search-results" role="list"></div>
      </div>
    </header>

    <slot />

    <footer>
      Built with care · <a href="/rss.xml">RSS</a>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.getElementById('theme-toggle');
        var html = document.documentElement;

        // What the reader is actually looking at right now: an explicit choice
        // if there is one, otherwise whatever the OS resolved to.
        function resolved() {
          var explicit = html.getAttribute('data-theme');
          if (explicit) return explicit;
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        function paintLabel() {
          var next = resolved() === 'dark' ? 'Light' : 'Dark';
          btn.textContent = next;
          btn.setAttribute('aria-label', 'Switch to ' + next.toLowerCase() + ' mode');
        }

        paintLabel();

        btn.addEventListener('click', function () {
          var next = resolved() === 'dark' ? 'light' : 'dark';
          html.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (e) {}
          paintLabel();
        });

        // Follow the OS while the reader has not chosen for themselves.
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
          if (!html.getAttribute('data-theme')) paintLabel();
        });
      })();
    </script>

    <script type="module">
      // Minimal client-side search (loads /search.json produced at build time)
      async function loadIndex() {
        try {
          const res = await fetch('/search.json');
          if (!res.ok) return [];
          return await res.json();
        } catch (e) { return []; }
      }

      function escapeHtml(s) {
        return s.replace(/[&<>\"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'})[c]);
      }

      (function() {
        const input = document.getElementById('search-input');
        const results = document.getElementById('search-results');
        let index = null;

        if (!input || !results) return;

        input.addEventListener('input', async (ev) => {
          const q = (ev.target.value || '').trim().toLowerCase();
          if (!q) {
            results.innerHTML = '';
            results.style.display = 'none';
            return;
          }

          if (!index) index = await loadIndex();

          const matches = index.filter(item => {
            const t = item.title || '';
            const e = item.excerpt || '';
            return t.toLowerCase().includes(q) || e.toLowerCase().includes(q);
          }).slice(0, 12);

          if (!matches.length) {
            results.innerHTML = '<div class="no-results">No results</div>';
            results.style.display = 'block';
            return;
          }

          results.innerHTML = matches.map(item => {
            return `<a class="search-result" role="listitem" href="${escapeHtml(item.url)}"><div class="search-title">${escapeHtml(item.title)}</div><div class="search-excerpt">${escapeHtml(item.excerpt || '')}</div></a>`;
          }).join('');

          results.style.display = 'block';
        });
      })();
    </script>
  </body>
</html>
