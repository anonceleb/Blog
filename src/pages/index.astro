---
import Layout from '../layouts/Layout.astro';
import { getGroups, getStartHere, seriesSlug } from '../lib/essays';

const groups = await getGroups();
const { essay, seriesName, seriesFirst } = await getStartHere();
---

<Layout description="A collection of stories and notes by Ashwin Kumar.">
  <p class="start-here">
    New here? Start with <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>, or read{' '}
    <a href={`/series/${seriesSlug(seriesName)}/`}>{seriesName}</a> from{' '}
    <a href={`/essays/${seriesFirst.id}/`}>the beginning</a>.
  </p>

  {groups.map((group) => (
    <section class="category-group">
      <h2>
        {group.kind === 'series' ? (
          <a href={`/series/${seriesSlug(group.name)}/`}>{group.label}</a>
        ) : (
          group.label
        )}
      </h2>

      {group.kind === 'series' && (
        <p class="group-note">A sequence, best read in order.</p>
      )}

      <ol class={group.kind === 'series' ? 'essay-list compact numbered' : 'essay-list compact'}>
        {group.entries.map((essay) => (
          <li>
            <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
          </li>
        ))}
      </ol>
    </section>
  ))}

  <hr />

  <p style="font-size: 0.9rem; color: var(--text-muted);">
    <a href="/rss.xml">Subscribe via RSS</a>
  </p>
</Layout>
