---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const allEssays = await getCollection('essays');

// Group by category, sort categories alphabetically, essays by title within groups
const grouped = allEssays.reduce((acc, essay) => {
  const cat = essay.data.category || 'Uncategorized';
  if (!acc[cat]) acc[cat] = [];
  acc[cat].push(essay);
  return acc;
}, {} as Record<string, typeof allEssays>);

// Sort categories
const categories = Object.keys(grouped).sort((a, b) => a.localeCompare(b));

// Within each category, sort essays by title (no dates on this page)
for (const cat of categories) {
  grouped[cat].sort((a, b) => a.data.title.localeCompare(b.data.title));
}
---

<Layout title="Home" description="A collection of essays and notes.">
  <p style="color: var(--text-muted); margin-bottom: 2rem; max-width: 60ch;">
    A small collection of writing. No dates on this page — just the ideas.
  </p>

  {
    categories.map((category) => (
      <div class="category-group">
        <h2>{category}</h2>
        <ul class="essay-list">
          {grouped[category].map((essay) => (
            <li>
              <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }

  <hr />

  <p style="font-size: 0.9rem; color: var(--text-muted);">
    {allEssays.length} essays. <a href="/categories">Browse by category</a> · <a href="/rss.xml">Subscribe via RSS</a>
  </p>
</Layout>
