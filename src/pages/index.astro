---
import Layout from '../layouts/Layout.astro';
import { getGroups, seriesSlug } from '../lib/essays';

const groups = await getGroups();
---

<Layout description="A collection of stories and notes by Ashwin Kumar.">
  {groups.map((group) => (
    <section class="category-group">
      <h2>
        {group.kind === 'series' ? (
          <a href={`/series/${seriesSlug(group.name)}/`}>{group.label}</a>
        ) : (
          group.label
        )}
      </h2>

      {group.kind === 'series' && (
        <p class="group-note">A sequence, best read in order.</p>
      )}

      <ol class={group.kind === 'series' ? 'essay-list numbered' : 'essay-list'}>
        {group.entries.map((essay) => (
          <li>
            <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
            {essay.data.description && <p class="essay-blurb">{essay.data.description}</p>}
          </li>
        ))}
      </ol>
    </section>
  ))}

  <hr />

  <p style="font-size: 0.9rem; color: var(--text-muted);">
    <a href="/rss.xml">Subscribe via RSS</a>
  </p>
</Layout>
