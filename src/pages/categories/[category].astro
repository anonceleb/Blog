---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { byRecency, categorySlug, seriesSlug } from '../../lib/essays';

export async function getStaticPaths() {
  const all = await getCollection('essays');
  const cats = [...new Set(all.map((e) => e.data.category))];
  return cats.map((c) => ({ params: { category: categorySlug(c) }, props: { displayName: c } }));
}

const { displayName } = Astro.props;
const allEssays = await getCollection('essays');

const filtered = allEssays
  .filter((e) => e.data.category === displayName)
  .sort(byRecency);
---

<Layout title={displayName} description={`Stories in the ${displayName} category.`}>
  <h1>{displayName}</h1>

  <div class="category-nav">
    <a href="/categories/">All categories</a>
  </div>

  {filtered.length === 0 ? (
    <p>Nothing here yet.</p>
  ) : (
    <ul class="essay-list">
      {filtered.map((essay) => (
        <li>
          <a href={`/essays/${essay.id}/`}>{essay.data.title}</a>
          {essay.data.series && (
            <a class="series-tag" href={`/series/${seriesSlug(essay.data.series)}/`}>
              {essay.data.series} · {essay.data.seriesOrder}
            </a>
          )}
          {essay.data.description && <p class="essay-blurb">{essay.data.description}</p>}
        </li>
      ))}
    </ul>
  )}

  <hr />
  <p><a href="/">← All</a></p>
</Layout>
