---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { categorySlug, seriesSlug } from '../../lib/essays';

const allEssays = await getCollection('essays');

const byCategory = allEssays.reduce((acc, e) => {
  acc[e.data.category] = (acc[e.data.category] || 0) + 1;
  return acc;
}, {} as Record<string, number>);

const categories = Object.entries(byCategory).sort(([a], [b]) => a.localeCompare(b));

const seriesNames = [...new Set(allEssays.map((e) => e.data.series).filter(Boolean))] as string[];
const series = seriesNames
  .map((name) => ({ name, count: allEssays.filter((e) => e.data.series === name).length }))
  .sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Categories" description="Browse the writing by category or series.">
  <h1>Categories</h1>

  <div class="category-nav" style="border-bottom: none; margin-bottom: 2rem;">
    {categories.map(([cat, count]) => (
      <a href={`/categories/${categorySlug(cat)}/`}>
        {cat} <span style="opacity:0.6">({count})</span>
      </a>
    ))}
  </div>

  {series.length > 0 && (
    <>
      <h2 style="font-size: 1rem;">Series</h2>
      <div class="category-nav" style="border-bottom: none; margin-bottom: 2rem;">
        {series.map((s) => (
          <a href={`/series/${seriesSlug(s.name)}/`}>
            {s.name} <span style="opacity:0.6">({s.count})</span>
          </a>
        ))}
      </div>
    </>
  )}

  <p style="color: var(--text-muted);">
    Or return to the <a href="/">full grouped list</a>.
  </p>
</Layout>
